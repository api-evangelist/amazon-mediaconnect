{
  "opencollection": "1.0.0",
  "info": {
    "name": "AWS MediaConnect Bridges Tags API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Amazon MediaConnect List Tags for Resource",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://mediaconnect.{region}.amazonaws.com/tags/:resourceArn",
            "headers": [
              {
                "name": "X-Amz-Content-Sha256",
                "value": ""
              },
              {
                "name": "X-Amz-Date",
                "value": ""
              },
              {
                "name": "X-Amz-Algorithm",
                "value": ""
              },
              {
                "name": "X-Amz-Credential",
                "value": ""
              },
              {
                "name": "X-Amz-Security-Token",
                "value": ""
              },
              {
                "name": "X-Amz-Signature",
                "value": ""
              },
              {
                "name": "X-Amz-SignedHeaders",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "resourceArn",
                "value": "arn:aws:mediaconnect:us-east-1:123456789012:flow:example-flow",
                "type": "path",
                "description": "The Amazon Resource Name (ARN) that identifies the AWS Elemental MediaConnect resource for which to list the tags."
              }
            ]
          },
          "docs": "List all tags on an AWS Elemental MediaConnect resource"
        },
        {
          "info": {
            "name": "Amazon MediaConnect Tag Resource",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://mediaconnect.{region}.amazonaws.com/tags/:resourceArn",
            "headers": [
              {
                "name": "X-Amz-Content-Sha256",
                "value": ""
              },
              {
                "name": "X-Amz-Date",
                "value": ""
              },
              {
                "name": "X-Amz-Algorithm",
                "value": ""
              },
              {
                "name": "X-Amz-Credential",
                "value": ""
              },
              {
                "name": "X-Amz-Security-Token",
                "value": ""
              },
              {
                "name": "X-Amz-Signature",
                "value": ""
              },
              {
                "name": "X-Amz-SignedHeaders",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "resourceArn",
                "value": "arn:aws:mediaconnect:us-east-1:123456789012:flow:example-flow",
                "type": "path",
                "description": "The Amazon Resource Name (ARN) that identifies the AWS Elemental MediaConnect resource to which to add tags."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Associates the specified tags to a resource with the specified resourceArn. If existing tags on a resource are not specified in the request parameters, they are not changed. When a resource is deleted, the tags associated with that resource are deleted as well."
        },
        {
          "info": {
            "name": "Amazon MediaConnect Untag Resource",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "http://mediaconnect.{region}.amazonaws.com/tags/:resourceArn#tagKeys",
            "headers": [
              {
                "name": "X-Amz-Content-Sha256",
                "value": ""
              },
              {
                "name": "X-Amz-Date",
                "value": ""
              },
              {
                "name": "X-Amz-Algorithm",
                "value": ""
              },
              {
                "name": "X-Amz-Credential",
                "value": ""
              },
              {
                "name": "X-Amz-Security-Token",
                "value": ""
              },
              {
                "name": "X-Amz-Signature",
                "value": ""
              },
              {
                "name": "X-Amz-SignedHeaders",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "resourceArn",
                "value": "arn:aws:mediaconnect:us-east-1:123456789012:flow:example-flow",
                "type": "path",
                "description": "The Amazon Resource Name (ARN) that identifies the AWS Elemental MediaConnect resource from which to delete tags."
              },
              {
                "name": "tagKeys",
                "value": "",
                "type": "query",
                "description": "The keys of the tags to be removed."
              }
            ]
          },
          "docs": "Deletes specified tags from a resource."
        }
      ]
    }
  ],
  "bundled": true
}